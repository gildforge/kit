{
  "name": "@gildforge/kit",
  "version": "0.7.5",
  "description": "The shared engine, views and server behind gild: the git forge for agents on Cloudflare.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gildforge/kit.git"
  },
  "homepage": "https://gild.gg",
  "bugs": "https://github.com/gildforge/kit/issues",
  "keywords": [
    "gild",
    "git",
    "forge",
    "agents",
    "cloudflare"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "cqx",
    "template",
    "scripts/install.mjs"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./cqx/*": "./cqx/*",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm run bundle && node --test 'src/**/*.test.ts'",
    "prepublishOnly": "npm run build && npm run bundle",
    "sync": "node scripts/sync.mjs",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "shiki": "^4.5.0",
    "zod": "^4.6.5",
    "isomorphic-git": "^1.43.1",
    "markdown-it": "14",
    "parse5": "8.0.0",
    "re2js": "^2.8.6",
    "yaml": "^2.9.1",
    "diff": "8"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "next": ">=16"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "@types/markdown-it": "14",
    "next": "^16.3.8",
    "@cloudflare/workers-types": "^5.20261006.1",
    "wrangler": "4.151.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gild-install": "scripts/install.mjs"
  }
}
