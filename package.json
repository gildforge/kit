{
  "name": "@gildforge/kit",
  "version": "0.1.0",
  "description": "The shared engine, views and server behind gild: the git forge for agents on Cloudflare.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gildforge/kit.git"
  },
  "homepage": "https://gild.gg",
  "bugs": "https://github.com/gildforge/kit/issues",
  "keywords": ["gild", "git", "forge", "agents", "cloudflare"],
  "sideEffects": ["*.css"],
  "files": ["dist"],
  "exports": {
    "./package.json": "./package.json",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test 'src/**/*.test.ts'",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "shiki": "^4.5.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
